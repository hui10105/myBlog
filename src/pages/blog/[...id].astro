---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, getRelatedPosts, getNeighbors, postReadingTime } from '../../lib/posts';
import { SITE, absoluteUrl, formatDateCN, toISODate, withBase } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, updated, tags, category, difficulty, summary, draft, cover } = post.data;

const posts = await getPosts();
const related = getRelatedPosts(post, posts, 3);
const { newer, older } = getNeighbors(post, posts);
const minutes = postReadingTime(post);

// 目录：只取二级、三级标题
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const canonical = absoluteUrl(Astro.url.pathname, Astro.site?.origin);
const rawMarkdownUrl = withBase(`/md/${post.id}.md`);
const mdFileUrl = new URL(rawMarkdownUrl, Astro.site?.origin ?? 'https://example.com').href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Organization', name: SITE.title },
  keywords: tags.join(', '),
  articleSection: category,
  inLanguage: SITE.lang,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={date.toISOString()}
  tags={tags}
  noindex={draft}
>
  <!-- 阅读进度 -->
  <div class="fixed top-0 left-0 z-50 h-0.5 w-full bg-transparent" aria-hidden="true">
    <div class="bg-accent h-full origin-left scale-x-0 transition-transform duration-75" data-progress></div>
  </div>

  <article class="container-page pt-10 pb-4 sm:pt-14">
    <!-- 文章头部 -->
    <header class="mx-auto max-w-3xl">
      <div class="text-muted flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs">
        <a class="text-accent hover:text-accent-hover font-medium transition-colors" href={withBase('/blog/')}>
          {category}
        </a>
        <span class="bg-line h-3 w-px" aria-hidden="true"></span>
        <span>{difficulty}</span>
        <span class="bg-line h-3 w-px" aria-hidden="true"></span>
        <time datetime={toISODate(date)}>{formatDateCN(date)}</time>
        <span class="bg-line h-3 w-px" aria-hidden="true"></span>
        <span>约 {minutes} 分钟</span>
        {draft && <span class="text-rose-500">草稿</span>}
      </div>

      <h1 class="animate-fade-up mt-4 text-[1.7rem] leading-[1.3] font-bold tracking-tight sm:text-[2.1rem]">
        {title}
      </h1>

      <p class="text-ink-soft animate-fade-up mt-4 text-[1.02rem] leading-relaxed">{description}</p>

      {
        updated && (
          <p class="text-muted mt-3 text-xs">
            最后更新于 <time datetime={toISODate(updated)}>{formatDateCN(updated)}</time>
          </p>
        )
      }

      <div class="mt-5 flex flex-wrap items-center gap-1.5">
        {tags.map((tag) => <a class="pill" href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>#{tag}</a>)}
      </div>
    </header>

    <!-- 封面图（frontmatter 里填了 cover 才显示） -->
    {
      cover && (
        <img
          src={withBase(cover)}
          alt={title}
          class="border-line mx-auto mt-8 max-w-3xl rounded-2xl border"
        />
      )
    }

    <!-- 要点速览：人和 AI 都能 10 秒抓重点 -->
    {
      summary.length > 0 && (
        <aside class="border-line bg-surface-2 mx-auto mt-8 max-w-3xl rounded-2xl border p-5 sm:p-6">
          <div class="flex items-center justify-between gap-3">
            <p class="eyebrow">要点速览</p>
            <span class="text-muted text-[0.7rem]">由 frontmatter 中的 summary 字段生成</span>
          </div>
          <ul class="mt-3 space-y-2">
            {summary.map((item) => (
              <li class="text-ink-soft flex gap-2.5 text-sm leading-relaxed">
                <span class="bg-accent mt-[0.5rem] h-1.5 w-1.5 shrink-0 rounded-full" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    <!-- 正文 + 目录 -->
    <div class="mx-auto mt-10 grid max-w-5xl gap-10 lg:grid-cols-[minmax(0,1fr)_15rem]">
      <div class="article max-w-3xl lg:max-w-none">
        <Content />

        <div class="border-line mt-12 border-t pt-6">
          <div class="flex flex-wrap items-center gap-3">
            <a class="btn" href={rawMarkdownUrl}>
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 3v5h5M6 3h9l5 5v13H6z"></path>
              </svg>
              查看 Markdown 源码
            </a>
            <button type="button" class="btn" data-copy-link data-url={canonical}>
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10 13a4 4 0 0 0 5.7 0l2.6-2.6a4 4 0 0 0-5.7-5.7L11 6.3"></path>
                <path d="M14 11a4 4 0 0 0-5.7 0L5.7 13.6a4 4 0 0 0 5.7 5.7L13 17.7"></path>
              </svg>
              <span data-copy-label>复制引用链接</span>
            </button>
          </div>

          <p class="text-muted mt-4 text-xs leading-relaxed">
            想让 AI 帮你总结这篇？把
            <a class="text-accent font-mono break-all" href={rawMarkdownUrl}>{mdFileUrl}</a>
            丢给智能体即可，它拿到的是带 frontmatter 的原始 Markdown。
          </p>
        </div>
      </div>

      <!-- 目录 -->
      {
        toc.length > 1 && (
          <aside class="hidden lg:block">
            <div class="sticky top-24">
              <p class="eyebrow mb-3">本文目录</p>
              <nav aria-label="文章目录">
                <ul class="border-line space-y-1.5 border-l">
                  {toc.map((heading) => (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        class:list={[
                          'text-muted hover:text-accent -ml-px block border-l-2 border-transparent py-0.5 text-xs leading-relaxed transition-colors',
                          heading.depth === 3 ? 'pl-6' : 'pl-3',
                        ]}
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          </aside>
        )
      }
    </div>

    <!-- 上一篇 / 下一篇 -->
    {
      (newer || older) && (
        <nav class="mx-auto mt-14 grid max-w-5xl gap-4 sm:grid-cols-2" aria-label="文章导航">
          {older ? (
            <a class="card group p-5" href={withBase(`/blog/${older.id}/`)}>
              <span class="text-muted text-xs">← 更早的一篇</span>
              <span class="text-ink group-hover:text-accent mt-1.5 block font-medium transition-colors">
                {older.data.title}
              </span>
            </a>
          ) : (
            <span />
          )}
          {newer ? (
            <a class="card group p-5 sm:text-right" href={withBase(`/blog/${newer.id}/`)}>
              <span class="text-muted text-xs">更新的一篇 →</span>
              <span class="text-ink group-hover:text-accent mt-1.5 block font-medium transition-colors">
                {newer.data.title}
              </span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }

    <!-- 相关文章 -->
    {
      related.length > 0 && (
        <section class="mx-auto mt-14 max-w-5xl">
          <h2 class="text-lg font-semibold tracking-tight">相关文章</h2>
          <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((item) => (
              <PostCard post={item} />
            ))}
          </div>
        </section>
      )
    }
  </article>

  <!-- 回到顶部 -->
  <button
    type="button"
    class="border-line bg-surface text-ink-soft hover:text-accent fixed right-5 bottom-5 z-30 hidden h-10 w-10 rounded-full border shadow-lg transition-colors"
    data-back-to-top
    title="回到顶部"
  >
    <span class="sr-only">回到顶部</span>
    <svg class="mx-auto h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 19V5M6 11l6-6 6 6"></path>
    </svg>
  </button>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <script is:inline>
    (function () {
      var bar = document.querySelector('[data-progress]');
      var toTop = document.querySelector('[data-back-to-top]');
      if (toTop) {
        toTop.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }
      function onScroll() {
        var doc = document.documentElement;
        var max = doc.scrollHeight - doc.clientHeight;
        var ratio = max > 0 ? Math.min(1, doc.scrollTop / max) : 0;
        if (bar) bar.style.transform = 'scaleX(' + ratio + ')';
        if (toTop) toTop.classList.toggle('hidden', doc.scrollTop < 600);
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // 复制引用链接
      var copyBtn = document.querySelector('[data-copy-link]');
      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          var label = copyBtn.querySelector('[data-copy-label]');
          var done = function () {
            if (label) label.textContent = '已复制 ✓';
            setTimeout(function () { if (label) label.textContent = '复制引用链接'; }, 1800);
          };
          var url = copyBtn.getAttribute('data-url');
          if (navigator.clipboard) {
            navigator.clipboard.writeText(url).then(done, done);
          } else {
            done();
          }
        });
      }
    })();
  </script>
</BaseLayout>

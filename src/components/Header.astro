---
import { SITE, withBase } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';
import SearchDialog from './SearchDialog.astro';

// 去掉 base 前缀，得到站点内的相对路径，用来判断导航高亮
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rawPath = Astro.url.pathname;
const relative = (base && rawPath.startsWith(base) ? rawPath.slice(base.length) : rawPath) || '/';
const currentPath = relative.endsWith('/') ? relative : `${relative}/`;

const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<header class="border-line bg-canvas/80 sticky top-0 z-40 border-b backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={withBase('/')} class="group flex items-center gap-2.5" aria-label={`${SITE.title} 首页`}>
      <span
        class="bg-accent text-accent-on grid h-9 w-9 place-items-center rounded-[10px] text-sm font-bold shadow-sm transition-transform group-hover:-rotate-6"
        aria-hidden="true">学</span
      >
      <span class="flex flex-col leading-tight">
        <span class="text-[0.95rem] font-semibold tracking-tight">{SITE.title}</span>
        <span class="text-muted hidden text-[0.7rem] sm:block">{SITE.tagline}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
      {
        SITE.nav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={[
              'rounded-lg px-3 py-1.5 text-sm transition-colors',
              isActive(item.href)
                ? 'text-accent bg-accent-soft font-medium'
                : 'text-ink-soft hover:text-ink hover:bg-surface-2',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <SearchDialog />
      <ThemeToggle />

      <button
        type="button"
        class="btn h-9 w-9 !px-0 md:hidden"
        data-menu-trigger
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">打开菜单</span>
        <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
          <path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="border-line bg-surface hidden border-t md:hidden" data-menu-panel>
    <nav class="container-page flex flex-col py-2" aria-label="移动端导航">
      {
        SITE.nav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={[
              'rounded-lg px-3 py-2.5 text-sm transition-colors',
              isActive(item.href) ? 'text-accent bg-accent-soft font-medium' : 'text-ink-soft hover:bg-surface-2',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var trigger = document.querySelector('[data-menu-trigger]');
    var panel = document.querySelector('[data-menu-panel]');
    if (!trigger || !panel) return;
    trigger.addEventListener('click', function () {
      var open = panel.classList.contains('hidden');
      panel.classList.toggle('hidden', !open);
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  })();
</script>

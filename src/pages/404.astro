---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/posts';
import { withBase } from '../lib/site';

const posts = (await getPosts()).slice(0, 4);
---

<BaseLayout title="页面不存在" description="这个地址下没有内容，也许链接写错了。">
  <div class="container-page flex flex-col items-center py-24 text-center sm:py-32">
    <p class="text-accent font-mono text-6xl font-bold tracking-tight sm:text-7xl">404</p>
    <h1 class="mt-5 text-2xl font-semibold tracking-tight sm:text-3xl">这个页面不存在</h1>
    <p class="text-ink-soft mt-4 max-w-md text-sm leading-relaxed">
      链接可能失效了，或者文章已经被重命名。可以回到首页，或者从下面几篇最近的文章开始。
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a class="btn btn-primary" href={withBase('/')}>回到首页</a>
      <a class="btn" href={withBase('/blog/')}>全部文章</a>
    </div>

    {
      posts.length > 0 && (
        <div class="mt-14 w-full max-w-lg text-left">
          <p class="eyebrow mb-3 text-center">最近更新</p>
          <ul class="border-line divide-line divide-y border-t border-b">
            {posts.map((post) => (
              <li>
                <a
                  class="text-ink-soft hover:text-accent block truncate py-2.5 text-sm transition-colors"
                  href={withBase(`/blog/${post.id}/`)}
                >
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</BaseLayout>

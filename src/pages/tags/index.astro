---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTags, getCategories } from '../../lib/posts';
import { withBase } from '../../lib/site';

const posts = await getPosts();
const tags = await getTags(posts);
const categories = await getCategories(posts);
const maxCount = tags[0]?.count ?? 1;

// 字号随文章数量变化，形成简单的标签云
const sizeFor = (count: number) => {
  const ratio = count / maxCount;
  if (ratio > 0.75) return 'text-base font-semibold';
  if (ratio > 0.4) return 'text-sm font-medium';
  return 'text-[0.82rem]';
};
---

<BaseLayout title="标签" description={`按标签浏览全部文章，共 ${tags.length} 个标签。`}>
  <div class="container-page pt-12 pb-6 sm:pt-16">
    <p class="eyebrow">Topics</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">标签</h1>
    <p class="text-ink-soft mt-4 max-w-2xl text-sm leading-relaxed">
      共 {tags.length} 个标签、{posts.length} 篇文章。字号越大表示该主题下的文章越多。
    </p>
  </div>

  <div class="container-page pb-8">
    <div class="card p-6 sm:p-8">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2.5">
        {
          tags.map((item) => (
            <a
              class:list={['hover:text-accent transition-colors', sizeFor(item.count)]}
              href={withBase(`/tags/${encodeURIComponent(item.tag)}/`)}
            >
              {item.tag}
              <sup class="text-muted ml-0.5 font-mono text-[0.65rem]">{item.count}</sup>
            </a>
          ))
        }
      </div>
      {tags.length === 0 && <p class="text-muted text-sm">还没有任何标签。</p>}
    </div>

    <section class="mt-12">
      <h2 class="text-xl font-semibold tracking-tight">按分类</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          categories.map((item) => (
            <div class="card p-5">
              <p class="text-ink font-medium">{item.tag}</p>
              <p class="text-muted mt-1 text-xs">{item.count} 篇</p>
              <ul class="mt-3 space-y-1.5">
                {item.posts.slice(0, 4).map((post) => (
                  <li>
                    <a
                      class="text-ink-soft hover:text-accent line-clamp-1 text-sm transition-colors"
                      href={withBase(`/blog/${post.id}/`)}
                    >
                      {post.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getCategories } from '../../lib/posts';
import { withBase } from '../../lib/site';
import { CATEGORIES, categoryNote } from '../../lib/categories';

const posts = await getPosts();
const grouped = new Map((await getCategories(posts)).map((item) => [item.tag, item.posts]));

// 以 site.config.mjs 声明的分类为准，还没有文章的也会显示出来
const categories = CATEGORIES.map((item) => ({
  name: item.name,
  note: item.note,
  posts: grouped.get(item.name) ?? [],
}));
---

<BaseLayout
  title="分类"
  description={`按分类浏览全部文章，共 ${categories.length} 个分类、${posts.length} 篇文章。`}
>
  <div class="container-page pt-12 pb-6 sm:pt-16">
    <p class="eyebrow">Categories</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">分类</h1>
    <p class="text-ink-soft mt-4 max-w-2xl text-sm leading-relaxed">
      分类是内容的骨架，用来区分一篇文章属于哪条主线；标签是细粒度的检索入口。分类清单写在
      <code class="font-mono text-xs">site.config.mjs</code> 里，新增分类只改那一处。
    </p>
  </div>

  <div class="container-page pb-12">
    <div class="grid gap-5 md:grid-cols-3">
      {
        categories.map((item) => (
          <div class="card flex flex-col p-6">
            <div class="flex items-baseline justify-between gap-3">
              <h2 class="text-lg font-semibold tracking-tight">
                <a
                  class="hover:text-accent transition-colors"
                  href={withBase(`/categories/${encodeURIComponent(item.name)}/`)}
                >
                  {item.name}
                </a>
              </h2>
              <span class="text-muted shrink-0 font-mono text-xs">{item.posts.length} 篇</span>
            </div>
            <p class="text-muted mt-2 text-xs leading-relaxed">{item.note}</p>

            {item.posts.length > 0 ? (
              <ul class="mt-4 space-y-1.5">
                {item.posts.slice(0, 3).map((post) => (
                  <li>
                    <a
                      class="text-ink-soft hover:text-accent line-clamp-1 text-sm transition-colors"
                      href={withBase(`/blog/${post.id}/`)}
                    >
                      {post.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-muted mt-4 text-xs">还没有文章，这个分类先留着。</p>
            )}

            <a
              class="text-accent mt-auto pt-4 text-sm"
              href={withBase(`/categories/${encodeURIComponent(item.name)}/`)}
            >
              查看全部 →
            </a>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>
